    <item>
      <title>구글을 지탱하는 기술</title>
      <link>https://ezaurum.com/reading/2011-11-12-%ea%b5%ac%ea%b8%80%ec%9d%84-%ec%a7%80%ed%83%b1%ed%95%98%eb%8a%94-%ea%b8%b0%ec%88%a0/</link>
