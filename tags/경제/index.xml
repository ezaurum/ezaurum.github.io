			<item>
				<title>경제학 콘서트</title>
				<link>https://ezaurum.com/2011/03/%EA%B2%BD%EC%A0%9C%ED%95%99-%EC%BD%98%EC%84%9C%ED%8A%B8/</link>
				<pubDate>Tue, 08 Mar 2011 00:00:00 +0000</pubDate>
