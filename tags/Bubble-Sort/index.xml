				<description>&lt;code&gt;&#xD;&#xA;void bubbleSort(int * array, int size)&#xD;&#xA;{&#xD;&#xA;&#x9;int temp = 0;&#xD;&#xA;&#x9;int j=0;&#xD;&#xA;&#x9;bool swapped = true;&#xD;&#xA;&#x9;while(swapped)&#xD;&#xA;&#x9;{&#xD;&#xA;&lt;del datetime=&#34;2011-01-13T07:13:28+00:00&#34;&gt;&#x9;&#x9;j++;&lt;/del&gt;&#xD;&#xA;&#x9;&#x9;swapped = false;&#xD;&#xA;&#x9;for( int i = 0; i &amp;lt; size -1 &lt;ins datetime=&#34;2011-01-13T07:13:28+00:00&#34;&gt;-j&lt;/ins&gt; ; i++)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;if ( array[i] &amp;gt; array[i+1] )&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;temp = array[i];&#xD;&#xA;&#x9;&#x9;&#x9;array[i] = array[i+1];&#xD;&#xA;&#x9;&#x9;&#x9;array[i+1] = temp;&#xD;&#xA;&#x9;&#x9;&#x9;swapped = true;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&lt;ins datetime=&#34;2011-01-13T07:13:28+00:00&#34;&gt;j++;&lt;/ins&gt;&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&lt;ins datetime=&#34;2011-01-13T08:05:15+00:00&#34;&gt;&#xD;&#xA;void swap(int * a, int * b)&#xD;&#xA;{&#xD;&#xA;&#x9;int temp = 0;&#xD;&#xA;&#x9;temp = *a;&#xD;&#xA;&#x9;*a = *b;&#xD;&#xA;&#x9;*b = temp;&#xD;&#xA;}&lt;/ins&gt;&#xD;&#xA;&lt;ins datetime=&#34;2011-01-13T08:06:26+00:00&#34;&gt;&#xD;&#xA;bool swapif(int * a, int * b)&#xD;&#xA;{&#xD;&#xA;&#x9;if ( *a &amp;gt; *b)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;swap(a,b);&#xD;&#xA;&#x9;&#x9;return true;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return false;&#xD;&#xA;&#x9;}&#xD;&#xA;}&lt;/ins&gt;&#xD;&#xA;&lt;p&gt;&lt;ins datetime=&#34;2011-01-13T08:07:57+00:00&#34;&gt;void bubbleSort2(int * array, int size)&lt;br&gt;&#xA;{&lt;br&gt;&#xA;int j=0;&lt;br&gt;&#xA;bool swapped = true;&lt;br&gt;&#xA;while(swapped)&lt;br&gt;&#xA;{&lt;br&gt;&#xA;swapped=false;&lt;br&gt;&#xA;for( int i = 0; i &amp;lt; size -j -1 ; i++)&lt;br&gt;&#xA;{&lt;br&gt;&#xA;swapped = swapif(array+i,array+i+1) ? true : swapped;&lt;br&gt;&#xA;}&lt;br&gt;&#xA;j++;&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;br&gt;&#xA;&lt;/ins&gt;&lt;/p&gt;&#xA;&lt;/code&gt;</description>
