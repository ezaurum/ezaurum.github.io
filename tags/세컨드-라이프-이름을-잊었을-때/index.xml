    <item>
      <title>세컨드 라이프란 걸 시작해 봤다.</title>
      <link>https://ezaurum.com/2008/04/%EC%84%B8%EC%BB%A8%EB%93%9C-%EB%9D%BC%EC%9D%B4%ED%94%84%EB%9E%80-%EA%B1%B8-%EC%8B%9C%EC%9E%91%ED%95%B4-%EB%B4%A4%EB%8B%A4./</link>
