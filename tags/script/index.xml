    <item>
      <title>bash 셀에서 변수 사용</title>
      <link>https://ezaurum.com/2013/05/bash-%EC%85%80%EC%97%90%EC%84%9C-%EB%B3%80%EC%88%98-%EC%82%AC%EC%9A%A9/</link>
