    <item>
      <title>구글을 지탱하는 기술</title>
      <link>https://ezaurum.com/2011/11/%EA%B5%AC%EA%B8%80%EC%9D%84-%EC%A7%80%ED%83%B1%ED%95%98%EB%8A%94-%EA%B8%B0%EC%88%A0/</link>
