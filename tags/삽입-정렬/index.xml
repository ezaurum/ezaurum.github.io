				<description>&lt;p&gt;&lt;code&gt;void  insertionSort(int * array, int size)&lt;br&gt;&#xA;{&lt;br&gt;&#xA;int j = 0;&lt;br&gt;&#xA;int temp = 0;&lt;br&gt;&#xA;for (int i = 1; i &amp;lt; size ; i++)&#x9;{&lt;br&gt;&#xA;j = 0;&lt;br&gt;&#xA;while(j&lt;i&gt; array[j]) {&lt;br&gt;&#xA;j++;&lt;br&gt;&#xA;}&lt;br&gt;&#xA;else {&lt;br&gt;&#xA;temp = array[i];&lt;br&gt;&#xA;for ( int k = i; k &amp;gt; j; k&amp;ndash;) {&lt;br&gt;&#xA;array[k] = array[k-1];&lt;br&gt;&#xA;}&lt;br&gt;&#xA;array[j] = temp;&lt;br&gt;&#xA;j = i;&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;/p&gt;&#xA;&lt;p&gt;&lt;ins datetime=&#34;2011-01-14T04:31:01+00:00&#34;&gt;void  insertionSort2(int * array, int size)&lt;br&gt;&#xA;{&lt;br&gt;&#xA;int j = 0;&lt;br&gt;&#xA;for (int i = 1; i  0 &amp;amp;&amp;amp; array[j-1] &amp;gt; array[j] ) {&lt;br&gt;&#xA;swap(array[j-1],array[j]);&lt;br&gt;&#xA;j&amp;ndash;;&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;br&gt;&#xA;}&lt;/ins&gt;&lt;/p&gt;</description>
