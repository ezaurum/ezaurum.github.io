    <item>
      <title>다음 주는 교생실습이다</title>
      <link>https://ezaurum.com/2008/10/%EB%8B%A4%EC%9D%8C-%EC%A3%BC%EB%8A%94-%EA%B5%90%EC%83%9D%EC%8B%A4%EC%8A%B5%EC%9D%B4%EB%8B%A4/</link>
