    <item>
      <title>인수 전달이 잘못된 문제</title>
      <link>https://ezaurum.com/2017/12/%EC%9D%B8%EC%88%98-%EC%A0%84%EB%8B%AC%EC%9D%B4-%EC%9E%98%EB%AA%BB%EB%90%9C-%EB%AC%B8%EC%A0%9C/</link>
